    },
    "submetida_em": {
      "type": "datetime"
    },
    "confirmada_em": {
      "type": "datetime"
    },
    "confirmacao_token": {
      "type": "string",
      "private": true
    },
    "requer_confirmacao": {
      "type": "boolean",
      "default": false,
      "private": true
    }
