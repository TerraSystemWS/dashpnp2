      "private": true
    },
    "url": {
      "type": "string",
      "unique": true,
      "private": true
    },
    "code": {
      "type": "string",
      "private": true
    },
    "nome_completo": {
      "type": "string"
    },
    "email": {
      "type": "email",
      "private": true
    },
    "sede": {
      "type": "text"
    },
    "telefone": {
      "type": "biginteger",
      "private": true
    },
    "categoria": {
      "type": "string"
    },
    "nome_projeto": {
      "type": "string"
    },
    "con_criativo": {
      "type": "text"
    },
    "coord_prod": {
      "type": "string"
    },
    "dir_foto": {
      "type": "string"
    },
    "dir_art": {
      "type": "string"
    },
    "realizador": {
      "type": "string"
    },
    "autor_jingle": {
      "type": "string"
    },
    "designer": {
      "type": "string"
    },
    "outras_consideracoes": {
      "type": "text"
    },
    "data_producao": {
      "type": "date"
    },
    "data_divulgacao": {
      "type": "date"
    },
    "data_apresentacao_publica": {
      "type": "date"
    },
    "editor": {
      "type": "string"
    },
    "fileLink": {
