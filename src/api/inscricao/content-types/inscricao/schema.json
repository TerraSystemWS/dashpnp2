    },
    "votacao_publicas": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::votacao-publica.votacao-publica",
      "mappedBy": "inscricoe"
    },
    "edicoes": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::edicao.edicao",
      "inversedBy": "inscricoes"
    },
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "inscricoes",
