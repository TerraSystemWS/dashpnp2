{
  "kind": "collectionType",
  "collectionName": "inscricoes",
  "info": {
    "singularName": "inscricao",
    "pluralName": "inscricoes",
    "displayName": "Inscrições",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "NIF": {
